# ================= Aangan Estates — Server configuration =================

# Port the API listens on
PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/aangan_estates

# ---------- JWT ----------
# Use a LONG random string in production! e.g. openssl rand -hex 64
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=12h

# ---------- Public URLs (used for emails, sitemap, CORS) ----------
CLIENT_URL=http://localhost:5173        # production: https://www.yourdomain.com
ADMIN_URL=http://localhost:5174         # production: https://admin.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------- Password reset ----------
RESET_TOKEN_TTL_MIN=15

# ---------- E-mail (SMTP) — Gmail ke liye ready ----------
# Google Account → Security → 2-Step Verification ON → App passwords → "Mail"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=youradmin@gmail.com
SMTP_PASS=your-16-char-app-password
NOTIFY_EMAIL=                         # DYNAMIC - khaali rakho. Enquiry emails DB me jo admin user hai usi ke email pe jayenge
#                                 (Settings -> Ownership Transfer se admin email change karo, mail wahi jayega)
EMAIL_FROM="Gurukripa Estate <youradmin@gmail.com>"

# ---------- Default admin (used by the seed script ONLY) ----------
ADMIN_EMAIL=               # SIRF fresh install default admin (jab DB khali ho) — khaali chhodo to SMTP_USER use hoga
ADMIN_PASSWORD=admin123
ADMIN_NAME=Aangan Admin
